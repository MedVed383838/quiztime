{
  "name": "quiztime-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:create": "prisma migrate dev --create-only --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "socket.io": "4.8.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "nodemon": "3.1.10",
    "prisma": "7.5.0",
    "supertest": "7.1.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.5.0": true,
    "@prisma/engines@7.5.0": true,
    "esbuild@0.28.1": true
  }
}
