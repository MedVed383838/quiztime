generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  displayName         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ownedQuizzes        Quiz[]               @relation("QuizOwner")
  hostedSessions      QuizSession[]        @relation("SessionHost")
  sessionParticipants SessionParticipant[]
}

model Category {
  id      Int    @id @default(autoincrement())
  name    String @unique
  slug    String @unique
  quizzes Quiz[]
}

model Quiz {
  id                       Int          @id @default(autoincrement())
  ownerUserId              Int
  categoryId               Int
  title                    String
  description              String?
  status                   QuizStatus   @default(DRAFT)
  defaultTimeLimitSeconds  Int          @default(30)
  defaultPointsPerQuestion Int          @default(1000)
  revealCorrectAnswer      Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  questions                Question[]
  category                 Category     @relation(fields: [categoryId], references: [id])
  owner                    User         @relation("QuizOwner", fields: [ownerUserId], references: [id])
  sessions                 QuizSession?
}

model Question {
  id               Int                 @id @default(autoincrement())
  quizId           Int
  text             String
  imageUrl         String?
  type             QuestionType
  timeLimitSeconds Int                 @default(30)
  position         Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  options          AnswerOption[]
  answers          ParticipantAnswer[]
  quiz             Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, position])
}

model AnswerOption {
  id                    Int                       @id @default(autoincrement())
  questionId            Int
  text                  String
  isCorrect             Boolean                   @default(false)
  position              Int
  question              Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantSelections ParticipantAnswerOption[]

  @@unique([questionId, position])
}

model QuizSession {
  id                   Int                  @id @default(autoincrement())
  quizId               Int                  @unique(map: "QuizSession_one_active_per_quiz", where: raw("(status = ANY (ARRAY['WAITING'::\"SessionStatus\", 'RUNNING'::\"SessionStatus\"]))"))
  hostUserId           Int
  pin                  String?              @unique
  status               SessionStatus        @default(WAITING)
  phase                SessionPhase?        @default(READY_FOR_QUESTION)
  timeLimitSeconds     Int
  pointsPerQuestion    Int
  revealCorrectAnswer  Boolean
  currentQuestionIndex Int                  @default(-1)
  questionStartedAt    DateTime?
  questionEndsAt       DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime             @default(now())
  host                 User                 @relation("SessionHost", fields: [hostUserId], references: [id])
  quiz                 Quiz                 @relation(fields: [quizId], references: [id])
  participants         SessionParticipant[]
}

model SessionParticipant {
  id                  Int                 @id @default(autoincrement())
  quizSessionId       Int
  userId              Int
  displayNameSnapshot String
  totalScore          Int                 @default(0)
  correctAnswersCount Int                 @default(0)
  joinedAt            DateTime            @default(now())
  disconnectedAt      DateTime?
  answers             ParticipantAnswer[]
  session             QuizSession         @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id])

  @@unique([quizSessionId, userId])
}

model ParticipantAnswer {
  id                   Int                       @id @default(autoincrement())
  sessionParticipantId Int
  questionId           Int
  isCorrect            Boolean
  submittedAt          DateTime                  @default(now())
  responseTimeMs       Int
  awardedPoints        Int
  question             Question                  @relation(fields: [questionId], references: [id])
  participant          SessionParticipant        @relation(fields: [sessionParticipantId], references: [id], onDelete: Cascade)
  selectedOptions      ParticipantAnswerOption[]

  @@unique([sessionParticipantId, questionId])
}

model ParticipantAnswerOption {
  participantAnswerId Int
  answerOptionId      Int
  answerOption        AnswerOption      @relation(fields: [answerOptionId], references: [id])
  participantAnswer   ParticipantAnswer @relation(fields: [participantAnswerId], references: [id], onDelete: Cascade)

  @@id([participantAnswerId, answerOptionId])
}

enum QuizStatus {
  DRAFT
  READY
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum SessionStatus {
  WAITING
  RUNNING
  FINISHED
  CANCELLED
}

enum SessionPhase {
  READY_FOR_QUESTION
  QUESTION_ACTIVE
  QUESTION_REVIEW
}
